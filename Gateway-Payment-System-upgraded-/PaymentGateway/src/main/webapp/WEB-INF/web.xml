<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <listener><listener-class>com.payment.AppContextListener</listener-class></listener>

  <!-- Guards every page + servlet, adds security headers, checks CSRF on POST -->
  <filter><filter-name>AuthFilter</filter-name><filter-class>com.payment.AuthFilter</filter-class></filter>
  <filter-mapping><filter-name>AuthFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>

  <servlet><servlet-name>LoginServlet</servlet-name><servlet-class>com.payment.LoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/LoginServlet</url-pattern></servlet-mapping>
  <servlet><servlet-name>LogoutServlet</servlet-name><servlet-class>com.payment.LogoutServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>LogoutServlet</servlet-name><url-pattern>/LogoutServlet</url-pattern></servlet-mapping>
  <servlet><servlet-name>PaymentServlet</servlet-name><servlet-class>com.payment.PaymentServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>PaymentServlet</servlet-name><url-pattern>/PaymentServlet</url-pattern></servlet-mapping>
  <servlet><servlet-name>HistoryServlet</servlet-name><servlet-class>com.payment.HistoryServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>HistoryServlet</servlet-name><url-pattern>/api/history</url-pattern></servlet-mapping>
  <servlet><servlet-name>CsrfServlet</servlet-name><servlet-class>com.payment.CsrfServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>CsrfServlet</servlet-name><url-pattern>/api/csrf</url-pattern></servlet-mapping>

  <session-config>
    <session-timeout>15</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- Add <secure>true</secure> once you serve over HTTPS -->
    </cookie-config>
  </session-config>

  <error-page><error-code>403</error-code><location>/error.html</location></error-page>
  <error-page><error-code>404</error-code><location>/error.html</location></error-page>
  <error-page><error-code>500</error-code><location>/error.html</location></error-page>

  <welcome-file-list><welcome-file>login.html</welcome-file></welcome-file-list>
</web-app>
